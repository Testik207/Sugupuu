<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Timuri leht</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Õpilane Timuri leht</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Ava menüü"><span class="navbar-toggler-icon"></span></button>
            <div class="navbar-collapse collapse" id="menu">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Teooria">XML/XSLT teooria</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Sugupuu">Sugupuu</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="MinuSugupuu">Minu sugupuu</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="XmlSkeem">XML skeem</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Reisid">Reisid</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container"><main role="main" class="pb-3">@RenderBody()</main></div>
<footer class="border-top footer text-muted"><div class="container">&copy; @DateTime.Now.Year - Õpilane Timuri leht</div></footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
